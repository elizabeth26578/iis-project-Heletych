
;; ЛР5. Діагностика несправностей автомобіля
;; Шаблони фактів

(deftemplate автомобіль
  (slot id)
  (slot виробник (default невідомий)))

(deftemplate obd_стан
  (slot авто)
  (slot підключено (default ні))
  (slot є_dtc (default невідомо)))

(deftemplate dtc
  (slot авто)
  (slot код)
  (slot перша_позиція)
  (slot друга_позиція)
  (slot система (default невідомо))
  (slot тип (default невідомо)))

(deftemplate параметр
  (slot авто)
  (slot назва)
  (slot значення)
  (slot стан (default норма)))

(deftemplate симптом
  (slot авто)
  (slot назва)
  (slot джерело (default користувач)))

(deftemplate гіпотеза
  (slot авто)
  (slot зона)
  (slot підстава)
  (slot впевненість (default 0.0)))

(deftemplate рекомендація
  (slot авто)
  (slot дія)
  (slot пріоритет (default середній)))

(deftemplate попередження
  (slot авто)
  (slot текст))

;; Початкові факти для тестування

(deffacts тестовий-випадок-P0300
  (автомобіль (id авто-1) (виробник невідомий))
  (obd_стан (авто авто-1)
            (підключено так)
            (є_dtc так))
  (dtc (авто авто-1)
       (код P0300)
       (перша_позиція P)
       (друга_позиція 0)
       (система невідомо)
       (тип невідомо)))

;; Правила з пріоритетом 10

(defrule R11-перевірити-помилки
  (declare (salience 10))
  (obd_стан (авто ?a)
            (підключено так)
            (є_dtc невідомо))
  =>
  (assert
    (рекомендація
      (авто ?a)
      (дія перевірити-наявність-dtc)
      (пріоритет високий))))

(defrule R2-система-P
  (declare (salience 10))
  ?d <- (dtc (авто ?a)
             (перша_позиція P)
             (система невідомо))
  =>
  (modify ?d (система двигун-або-акпп)))

(defrule R3-система-B
  (declare (salience 10))
  ?d <- (dtc (авто ?a)
             (перша_позиція B)
             (система невідомо))
  =>
  (modify ?d (система кузовні-системи)))

(defrule R4-система-C
  (declare (salience 10))
  ?d <- (dtc (авто ?a)
             (перша_позиція C)
             (система невідомо))
  =>
  (modify ?d (система шасі)))

(defrule R5-система-U
  (declare (salience 10))
  ?d <- (dtc (авто ?a)
             (перша_позиція U)
             (система невідомо))
  =>
  (modify ?d (система взаємодія-електронних-блоків)))

(defrule R6-загальний-код
  (declare (salience 10))
  ?d <- (dtc (авто ?a)
             (друга_позиція 0)
             (тип невідомо))
  =>
  (modify ?d (тип generic)))

(defrule R7-код-виробника-1
  (declare (salience 10))
  ?d <- (dtc (авто ?a)
             (друга_позиція 1)
             (тип невідомо))
  =>
  (modify ?d (тип manufacturer)))

(defrule R7-код-виробника-2
  (declare (salience 10))
  ?d <- (dtc (авто ?a)
             (друга_позиція 2)
             (тип невідомо))
  =>
  (modify ?d (тип manufacturer)))

(defrule R8-резервна-позиція
  (declare (salience 10))
  ?d <- (dtc (авто ?a)
             (друга_позиція 3)
             (тип невідомо))
  =>
  (modify ?d (тип reserve)))

(defrule R10-спочатку-визначити-систему
  (declare (salience 10))
  (dtc (авто ?a) (система невідомо))
  (not
    (рекомендація
      (авто ?a)
      (дія визначити-систему-за-першою-позицією)))
  =>
  (assert
    (рекомендація
      (авто ?a)
      (дія визначити-систему-за-першою-позицією)
      (пріоритет високий))))

;; Основні правила

(defrule R1-dtc-визначає-зону
  (dtc (авто ?a) (система ?s&~невідомо))
  (not
    (гіпотеза (авто ?a)
              (зона ?s)
              (підстава dtc)))
  =>
  (assert
    (гіпотеза (авто ?a)
              (зона ?s)
              (підстава dtc)
              (впевненість 0.6))))

(defrule R9-врахувати-виробника
  (dtc (авто ?a) (тип manufacturer))
  (автомобіль (id ?a) (виробник ?m&~невідомий))
  =>
  (assert
    (рекомендація
      (авто ?a)
      (дія використати-таблицю-кодів-виробника)
      (пріоритет високий))))

(defrule L1-код-виробника-без-марки
  (dtc (авто ?a) (тип manufacturer))
  (автомобіль (id ?a) (виробник невідомий))
  =>
  (assert
    (попередження
      (авто ?a)
      (текст потрібен-виробник-для-розшифрування)))
  (assert
    (рекомендація
      (авто ?a)
      (дія уточнити-виробника)
      (пріоритет високий))))

(defrule R12-відображати-поточні-параметри
  (параметр (авто ?a)
            (назва ?n)
            (значення ?v))
  =>
  (printout t
    "Поточний параметр " ?n
    " = " ?v
    " для " ?a crlf))

(defrule R13-відхилення-як-ознака
  (параметр (авто ?a)
            (назва ?n)
            (стан відхилення))
  (not
    (симптом (авто ?a)
             (назва ?n)
             (джерело параметр)))
  =>
  (assert
    (симптом
      (авто ?a)
      (назва ?n)
      (джерело параметр))))

(defrule R14-розшифрувати-dtc
  (dtc (авто ?a) (код ?c))
  (not
    (рекомендація
      (авто ?a)
      (дія розшифрувати-dtc)))
  =>
  (assert
    (рекомендація
      (авто ?a)
      (дія розшифрувати-dtc)
      (пріоритет високий))))

(defrule R15-врахувати-dtc-та-параметри
  (dtc (авто ?a))
  (параметр (авто ?a) (стан відхилення))
  =>
  (assert
    (рекомендація
      (авто ?a)
      (дія зіставити-dtc-з-поточними-параметрами)
      (пріоритет високий))))

(defrule E1-dtc-не-остаточний-діагноз
  (dtc (авто ?a))
  (not
    (попередження
      (авто ?a)
      (текст dtc-не-є-остаточним-діагнозом)))
  =>
  (assert
    (попередження
      (авто ?a)
      (текст dtc-не-є-остаточним-діагнозом))))

(defrule E2-можливі-відхилення-структури
  (dtc (авто ?a) (тип reserve))
  =>
  (assert
    (попередження
      (авто ?a)
      (текст структура-коду-потребує-додаткової-перевірки))))

(defrule E3-виробник-змінює-тлумачення
  (dtc (авто ?a) (тип manufacturer))
  =>
  (assert
    (попередження
      (авто ?a)
      (текст код-залежить-від-виробника))))

(defrule M3-формувати-ймовірну-зону
  (гіпотеза
    (авто ?a)
    (зона ?z)
    (впевненість ?cf&:(< ?cf 1.0)))
  =>
  (printout t
    "Ймовірна зона несправності: " ?z
    ", а не остаточно підтверджена деталь."
    crlf))

(defrule G3-діагностика-без-dtc
  (obd_стан (авто ?a) (є_dtc ні))
  (симптом (авто ?a) (назва ?s))
  =>
  (assert
    (гіпотеза
      (авто ?a)
      (зона потребує-уточнення)
      (підстава симптом)
      (впевненість 0.4)))
  (assert
    (рекомендація
      (авто ?a)
      (дія аналізувати-симптоми-та-поточні-параметри)
      (пріоритет високий))))

(defrule G4-кілька-dtc
  (dtc (авто ?a) (код ?c1))
  (dtc (авто ?a) (код ?c2&~?c1))
  (not
    (попередження
      (авто ?a)
      (текст зареєстровано-кілька-dtc)))
  =>
  (assert
    (попередження
      (авто ?a)
      (текст зареєстровано-кілька-dtc)))
  (assert
    (рекомендація
      (авто ?a)
      (дія проаналізувати-взаємозв'язок-dtc)
      (пріоритет високий))))

(defrule G6-суперечливі-ознаки
  (гіпотеза (авто ?a) (зона ?z1))
  (гіпотеза (авто ?a) (зона ?z2&~?z1))
  (not
    (попередження
      (авто ?a)
      (текст суперечливі-діагностичні-дані)))
  =>
  (assert
    (попередження
      (авто ?a)
      (текст суперечливі-діагностичні-дані)))
  (assert
    (рекомендація
      (авто ?a)
      (дія виконати-додаткові-перевірки)
      (пріоритет високий))))

(defrule G1-G7-не-завищувати-впевненість
  (гіпотеза
    (авто ?a)
    (впевненість ?cf&:(<= ?cf 0.6)))
  =>
  (assert
    (рекомендація
      (авто ?a)
      (дія підтвердити-гіпотезу-додатковими-ознаками)
      (пріоритет середній))))

;; Фінальні правила

(defrule фінал-гіпотеза
  (declare (salience -10))
  (гіпотеза
    (авто ?a)
    (зона ?z)
    (підстава ?b)
    (впевненість ?cf))
  =>
  (printout t
    "Авто " ?a
    ": зона " ?z
    ", підстава " ?b
    ", впевненість " ?cf crlf))

(defrule фінал-рекомендація
  (declare (salience -10))
  (рекомендація
    (авто ?a)
    (дія ?d)
    (пріоритет ?p))
  =>
  (printout t
    "Рекомендація: " ?d
    ", пріоритет " ?p crlf))
