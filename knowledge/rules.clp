Перенесення правил

;; ---------- salience 10: отримання та нормалізація даних ----------


;; R11
(defrule R11-перевірити-помилки
 (declare (salience 10))
 (obd_стан (авто ?a) (підключено так) (є_dtc невідомо))
=>
 (assert (рекомендація (авто ?a) (дія перевірити-наявність-dtc)
                        (пріоритет високий))))


;; R2
(defrule R2-система-P
 (declare (salience 10))
 ?d <- (dtc (авто ?a) (перша_позиція P) (система невідомо))
=>
 (modify ?d (система двигун-або-акпп)))


;; R3
(defrule R3-система-B
 (declare (salience 10))
 ?d <- (dtc (авто ?a) (перша_позиція B) (система невідомо))
=>
 (modify ?d (система кузовні-системи)))




;; R4
(defrule R4-система-C
 (declare (salience 10))
 ?d <- (dtc (авто ?a) (перша_позиція C) (система невідомо))
=>
 (modify ?d (система шасі)))


;; R5
(defrule R5-система-U
 (declare (salience 10))
 ?d <- (dtc (авто ?a) (перша_позиція U) (система невідомо))
=>
 (modify ?d (система взаємодія-електронних-блоків)))


;; R6
(defrule R6-загальний-код
 (declare (salience 10))
 ?d <- (dtc (авто ?a) (друга_позиція 0) (тип невідомо))
=>
 (modify ?d (тип generic)))


;; R7 (1)
(defrule R7-код-виробника-1
 (declare (salience 10))
 ?d <- (dtc (авто ?a) (друга_позиція 1) (тип невідомо))
=>
 (modify ?d (тип manufacturer)))


;; R7 (2)
(defrule R7-код-виробника-2
 (declare (salience 10))
 ?d <- (dtc (авто ?a) (друга_позиція 2) (тип невідомо))
=>
 (modify ?d (тип manufacturer)))


;; R8
(defrule R8-резервна-позиція
 (declare (salience 10))
 ?d <- (dtc (авто ?a) (друга_позиція 3) (тип невідомо))
=>
 (modify ?d (тип reserve)))










;; R10 + M1
(defrule R10-спочатку-визначити-систему
 (declare (salience 10))
 (dtc (авто ?a) (система невідомо))
 (not (рекомендація (авто ?a) (дія визначити-систему-за-першою-позицією)))
=>
 (assert (рекомендація (авто ?a)
         (дія визначити-систему-за-першою-позицією)
         (пріоритет високий))))


;; ---------- salience 0: основна логіка ----------


;; R1
(defrule R1-dtc-визначає-зону
 (dtc (авто ?a) (система ?s&~невідомо))
 (not (гіпотеза (авто ?a) (зона ?s) (підстава dtc)))
=>
 (assert (гіпотеза (авто ?a) (зона ?s)
         (підстава dtc) (впевненість 0.6))))


;; R9
(defrule R9-врахувати-виробника
 (dtc (авто ?a) (тип manufacturer))
 (автомобіль (id ?a) (виробник ?m&~невідомий))
=>
 (assert (рекомендація (авто ?a)
         (дія використати-таблицю-кодів-виробника)
         (пріоритет високий))))


;; L1 + E3: код виробника без марки не можна універсально тлумачити
(defrule L1-код-виробника-без-марки
 (dtc (авто ?a) (тип manufacturer))
 (автомобіль (id ?a) (виробник невідомий))
=>
 (assert (попередження (авто ?a)
         (текст потрібен-виробник-для-розшифрування)))
 (assert (рекомендація (авто ?a)
         (дія уточнити-виробника)
         (пріоритет високий))))


;; R12
(defrule R12-відображати-поточні-параметри
 (параметр (авто ?a) (назва ?n) (значення ?v))
=>
 (printout t "Поточний параметр " ?n " = " ?v " для " ?a crlf))


;; R13
(defrule R13-відхилення-як-ознака
 (параметр (авто ?a) (назва ?n) (стан відхилення))
 (not (симптом (авто ?a) (назва ?n) (джерело параметр)))
=>
 (assert (симптом (авто ?a) (назва ?n) (джерело параметр))))


;; R14
(defrule R14-розшифрувати-dtc
 (dtc (авто ?a) (код ?c))
 (not (рекомендація (авто ?a) (дія розшифрувати-dtc)))
=>
 (assert (рекомендація (авто ?a) (дія розшифрувати-dtc)
                        (пріоритет високий))))


;; R15 + M2
(defrule R15-врахувати-dtc-та-параметри
 (dtc (авто ?a))
 (параметр (авто ?a) (стан відхилення))
=>
 (assert (рекомендація (авто ?a)
         (дія зіставити-dtc-з-поточними-параметрами)
         (пріоритет високий))))


;; E1 + L2
(defrule E1-dtc-не-остаточний-діагноз
 (dtc (авто ?a))
 (not (попередження (авто ?a) (текст dtc-не-є-остаточним-діагнозом)))
=>
 (assert (попередження (авто ?a)
         (текст dtc-не-є-остаточним-діагнозом))))


;; E2
(defrule E2-можливі-відхилення-структури
 (dtc (авто ?a) (тип reserve))
=>
 (assert (попередження (авто ?a)
         (текст структура-коду-потребує-додаткової-перевірки))))


;; E3
(defrule E3-виробник-змінює-тлумачення
 (dtc (авто ?a) (тип manufacturer))
=>
 (assert (попередження (авто ?a)
         (текст код-залежить-від-виробника))))


;; M3
(defrule M3-формувати-ймовірну-зону
 (гіпотеза (авто ?a) (зона ?z) (впевненість ?cf&:(< ?cf 1.0)))
=>
 (printout t "Ймовірна зона несправності: " ?z
             ", а не остаточно підтверджена деталь." crlf))


;; G3: сценарій без DTC
(defrule G3-діагностика-без-dtc
 (obd_стан (авто ?a) (є_dtc ні))
 (симптом (авто ?a) (назва ?s))
=>
 (assert (гіпотеза (авто ?a) (зона потребує-уточнення)
         (підстава симптом) (впевненість 0.4)))
 (assert (рекомендація (авто ?a)
         (дія аналізувати-симптоми-та-поточні-параметри)
         (пріоритет високий))))


;; G4: кілька DTC
(defrule G4-кілька-dtc
 (dtc (авто ?a) (код ?c1))
 (dtc (авто ?a) (код ?c2&~?c1))
 (not (попередження (авто ?a) (текст зареєстровано-кілька-dtc)))
=>
 (assert (попередження (авто ?a) (текст зареєстровано-кілька-dtc)))
 (assert (рекомендація (авто ?a)
         (дія проаналізувати-взаємозв'язок-dtc)
         (пріоритет високий))))


;; G6: суперечливі дані
(defrule G6-суперечливі-ознаки
 (гіпотеза (авто ?a) (зона ?z1))
 (гіпотеза (авто ?a) (зона ?z2&~?z1))
 (not (попередження (авто ?a) (текст суперечливі-діагностичні-дані)))
=>
 (assert (попередження (авто ?a)
         (текст суперечливі-діагностичні-дані)))
 (assert (рекомендація (авто ?a)
         (дія виконати-додаткові-перевірки)
         (пріоритет високий))))












;; G1/G7: невизначені ваги та поріг
(defrule G1-G7-не-завищувати-впевненість
 (гіпотеза (авто ?a) (впевненість ?cf&:(<= ?cf 0.6)))
=>
 (assert (рекомендація (авто ?a)
         (дія підтвердити-гіпотезу-додатковими-ознаками)
         (пріоритет середній))))


;; ---------- salience -10: фінальний висновок ----------


(defrule фінал-гіпотеза
 (declare (salience -10))
 (гіпотеза (авто ?a) (зона ?z) (підстава ?b) (впевненість ?cf))
=>
 (printout t "Авто " ?a ": зона " ?z ", підстава " ?b
             ", впевненість " ?cf crlf))


(defrule фінал-рекомендація
 (declare (salience -10))
 (рекомендація (авто ?a) (дія ?d) (пріоритет ?p))
=>
 (printout t "Рекомендація: " ?d ", пріоритет " ?p crlf))
